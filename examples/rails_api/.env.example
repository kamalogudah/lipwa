# Copy to .env and fill in with credentials from your own Daraja developer
# account: https://developer.safaricom.co.ke/ (Test Credentials page for the
# sandbox values below; never commit real credentials).

MPESA_ENV=sandbox

# Every Daraja call:
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# STK Push / C2B:
MPESA_SHORTCODE=
MPESA_PASSKEY=

# #disburse / #refund only:
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Path to the Daraja sandbox/production certificate (PEM/DER) on disk.
MPESA_CERT_PATH=

# Host Daraja's callbacks are sent to (e.g. an ngrok tunnel: abc123.ngrok.io).
# Defaults to localhost:3000, which Safaricom's sandbox cannot reach.
APP_HOST=localhost:3000

# Jenga HQ / Finserve sandbox
JENGA_ENV=sandbox
JENGA_API_KEY=
JENGA_MERCHANT_CODE=
JENGA_CONSUMER_SECRET=
JENGA_PRIVATE_KEY_PATH=privatekey.pem
JENGA_SOURCE_ACCOUNT=1100194977404
JENGA_SOURCE_NAME=
JENGA_COUNTRY_CODE=KE
JENGA_PARTNER_ID=
JENGA_WEBHOOK_USERNAME=
JENGA_WEBHOOK_PASSWORD=
